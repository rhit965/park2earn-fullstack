# Copy this file to .env.local and paste values from YOUR Supabase dashboard.
# Dashboard > Project Settings > API (or Connect > API Keys).
# The "publishable" key or legacy "anon" key is safe for a browser with RLS enabled.
# NEVER put your service_role / secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
